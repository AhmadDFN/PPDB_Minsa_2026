<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_NAME" value="PPDB Minsatama"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="DB_TEST_URL" value="" force="true"/>
        <env name="DB_TEST_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_TEST_PORT" value="3306" force="true"/>
        <env name="DB_TEST_DATABASE" value="ppdb_minsatama_cc_concurrency_test" force="true"/>
        <env name="DB_TEST_SOCKET" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="NIK_HMAC_KEY" value="test-nik-hmac-secret-key-distinct-from-app-key-12345"/>
        <env name="OTP_HMAC_KEY" value="test-otp-hmac-secret-key-distinct-from-all-1234567890"/>
        <env name="OTP_DRIVER" value="array"/>
        <env name="SUPERADMIN_PASSWORD" value="test-only-superadmin-password"/>
        <env name="DEFAULT_ADMIN_PASSWORD" value="test-only-admin-password"/>
        <env name="OTP_DELIVERY_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
