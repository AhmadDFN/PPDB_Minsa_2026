APP_NAME="PPDB MIN 1 Kota Madiun"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://sleek-forestgreen-mink-13.hostingersite.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u_database_staging
DB_USERNAME=u_username_staging
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=ppdb_staging_cache_

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# KUNCI KRIPTOGRAFI MANDIRI MINSATAMA (DI-GENERATE TERPISAH MENGGUNAKAN CSPRNG 256-bit)
NIK_HMAC_KEY=
OTP_HMAC_KEY=

# Provider Gateway WhatsApp (Staging menggunakan log sandbox)
WHATSAPP_GATEWAY_PROVIDER=log
